# ---------- worker (FastAPI + kolejka) — sekrety TYLKO po stronie serwera ----------
DATABASE_URL=postgresql://mdb:mdb@localhost:5432/mdb   # Supabase: connection string roli postgres (Session pooler)
AUTH_MODE=local                # local (dev bez Supabase) | supabase
JWT_SECRET=zmien-mnie-min-32-znaki-zmien-mnie-0000     # local: wymagany; supabase: tylko starszy tryb HS256
SUPABASE_URL=                  # https://<ref>.supabase.co (JWKS do weryfikacji tokenów + Storage)
SUPABASE_SERVICE_ROLE_KEY=     # NIGDY nie trafia do frontendu
STORAGE_MODE=local             # local | supabase
STORAGE_DIR=.data/storage
STORAGE_BUCKET=mdb-files
INLINE_WORKER=0                # 1 = worker w procesie API (tylko dev)
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=20
MAX_ROWS=5000
EXPORT_TTL_HOURS=72

# ---------- web (Next.js) — wyłącznie wartości publiczne ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=local    # local | supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
